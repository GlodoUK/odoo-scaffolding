{# We cannot use the same pre-commit config as MQT's because paths don't match -#}

{%- set repo_rev = namespace() %}

{%- set repo_rev.ruff = "v0.14.0" %}
{%- set repo_rev.pre_commit_hooks = "v4.6.0" %}
{%- set repo_rev.xmllint = "b9281d1" %}
{%- set repo_rev.oca_pre_commit_hooks = "v0.1.6" %}
{%- set repo_rev.pylint_odoo = "v9.3.18" %}

{%- if odoo_version <= 15 %}
  {%- set repo_rev.eslint = "7.8.1" %}
  {%- set repo_rev.nodejs = "14.13.0" %}
  {%- set repo_rev.prettier = "2.1.2" %}
{%- elif odoo_version <= 16 %}
  {%- set repo_rev.eslint = "8.19.0" %}
  {%- set repo_rev.nodejs = "14.18.0" %}
  {%- set repo_rev.prettier = "2.7.1" %}
{%- elif odoo_version <= 17 %}
  {%- set repo_rev.eslint = "8.56.0" %}
  {%- set repo_rev.nodejs = "20.10.0" %}
  {%- set repo_rev.prettier = "3.1.0" %}
{%- elif odoo_version <= 18 %}
  {%- set repo_rev.eslint = "9.17.0" %}
  {%- set repo_rev.eslint_jsdoc = "60.3.1" %}
  {%- set repo_rev.nodejs = "22.12.0" %}
  {%- set repo_rev.prettier = "3.6.2" %}
{%- else %}
  {%- set repo_rev.eslint = "9.36.0" %}
  {%- set repo_rev.eslint_jsdoc = "57.0.8" %}
  {%- set repo_rev.nodejs = "22.20.0" %}
  {%- set repo_rev.prettier = "3.6.2" %}
{%- endif %}

{%- set excludes = [
  '/static/description/index\.html$',
  '.*\.(diff|patch)$',
  '/static/(src/)?lib/',
  '(LICENSE.*|COPYING.*)',
  '^eslint.config.cjs|^prettier.config.cjs',
] + pre_commit_extra_excludes|default([]) -%}

exclude: |
  (?x)
  {{ excludes | join("|\n") | indent(2) }}
default_language_version:
  python: python3
  node: "{{ repo_rev.nodejs }}"
repos:
  - repo: local
    hooks:
      - id: forbidden-files
        name: forbidden files
        entry: found forbidden files; remove them
        language: fail
        files: "\\.rej$"
  {% if odoo_version >= 14 -%}
  - repo: https://github.com/OCA/odoo-pre-commit-hooks
    rev: {{ repo_rev.oca_pre_commit_hooks }}
    hooks:
      - id: oca-checks-odoo-module
      - id: oca-checks-po
        args: ["--fix"]
  {% endif -%}
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: "{{ repo_rev.ruff }}"
    hooks:
      # Run the linter.
      - id: ruff
        args: [ --fix, --exit-non-zero-on-fix ]
      # Run the formatter.
      - id: ruff-format
  - repo: https://github.com/OCA/pylint-odoo
    rev: "{{ repo_rev.pylint_odoo }}"
    hooks:
      - id: pylint_odoo
        name: pylint with optional checks
        args:
          - --rc-file=.pylintrc
          - --exit-zero
        verbose: true
      - id: pylint_odoo
        name: pylint with mandatory checks
        args:
          - --rc-file=.pylintrc-mandatory
  - repo: local
    hooks:
      - id: prettier
        name: prettier
        entry: prettier
        args:
          - --write
          - --list-different
          - --ignore-unknown
        types: [text]
        files: \.(css|htm|html|js|json|jsx|less|md|scss|toml|ts|yaml|yml)$
        language: node
        additional_dependencies:
          - "prettier@{{ repo_rev.prettier }}"
  - repo: https://github.com/GlodoUK/pre-commit-xmllint
    rev: {{ repo_rev.xmllint }}
    hooks:
      - id: lxml-format
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: {{ repo_rev.pre_commit_hooks }}
    hooks:
      - id: trailing-whitespace
        # exclude autogenerated files
        exclude: /README\.rst$|\.pot?$
      - id: end-of-file-fixer
        # exclude autogenerated files
        exclude: /README\.rst$|\.pot?$
      {%- if odoo_version >= 11 %}
      - id: debug-statements
      {%- endif %}
      - id: fix-encoding-pragma
        {%- if odoo_version >= 11 %}
        args: ["--remove"]
        {%- endif %}
      - id: check-case-conflict
      - id: check-docstring-first
      - id: check-executables-have-shebangs
      - id: check-merge-conflict
      - id: check-symlinks
      - id: check-xml
      - id: mixed-line-ending
        args: ["--fix=lf"]
  - repo: local
    hooks:
      - id: eslint
        name: eslint
        entry: eslint
        args:
          - --color
          - --fix
        verbose: true
        types: [javascript]
        language: node
        additional_dependencies:
          - "eslint@{{ repo_rev.eslint }}"
          {%- if odoo_version >= 18 %}
          - "eslint-plugin-jsdoc@{{ repo_rev.eslint_jsdoc }}"
          {%- endif %}
